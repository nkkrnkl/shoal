{
  "name": "shoal",
  "private": true,
  "packageManager": "pnpm@10.34.6",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "pnpm --filter @shoal/extension dev",
    "build": "pnpm --filter @shoal/extension build",
    "zip": "pnpm --filter @shoal/extension zip",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "lint": "biome ci .",
    "format": "biome check --write ."
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.15",
    "@types/node": "^26.6.5",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3"
  }
}
